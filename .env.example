# Copiar a .env y completar. .env esta en .gitignore: nunca se commitea.
GARMIN_EMAIL=tu-email@ejemplo.com
GARMIN_PASSWORD=tu-password

# Donde cachear los tokens OAuth (default: ~/.garminconnect).
# Se escribe solo despues del primer login exitoso (incluido el MFA).
GARMINTOKENS=~/.garminconnect

# Raiz de la data cruda (default: ./data/raw)
GARMIN_GOLF_RAW_DIR=data/raw

# --- Postgres / stack docker -------------------------------------------------
POSTGRES_USER=golf
POSTGRES_PASSWORD=golf
POSTGRES_DB=golf
POSTGRES_PORT=5433
API_PORT=8010
WEB_PORT=5173
# Para correr el ETL desde el host (fuera de docker):
DATABASE_URL=postgresql://golf:golf@localhost:5433/golf
